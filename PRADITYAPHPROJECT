<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Biodata Praditya Puji Hanggoro</title>

    <!-- Bootstrap CDN -->
    <link 
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
        rel="stylesheet"
    >
</head>

<body class="bg-light">

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                <!-- Card Biodata -->
                <div class="card shadow border-0">
                    <div class="card-body text-center p-4">

                        <!-- Foto -->
                        <div class="mb-3">
                            <img 
                                src="https://via.placeholder.com/150" 
                                alt="Foto Praditya"
                                class="rounded-circle img-fluid"
                                width="150"
                                height="150"
                            >
                        </div>

                        <!-- Nama -->
                        <h1 class="h3 fw-bold text-primary">
                            Praditya Puji Hanggoro
                        </h1>

                        <p class="text-muted mb-4">
                            Mahasiswa Semester 1
                        </p>

                        <!-- Biodata -->
                        <div class="text-start">
                            <div class="row mb-3">
                                <div class="col-5 fw-bold">Nama</div>
                                <div class="col-7">Praditya Puji Hanggoro</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-5 fw-bold">Kelas</div>
                                <div class="col-7">Komputerisasi Akuntansi</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-5 fw-bold">Semester</div>
                                <div class="col-7">1</div>
                            </div>
                        </div>

                    </div>

                    <!-- Footer -->
                    <div class="card-footer text-center text-muted">
                        &copy; 2026 Praditya Puji Hanggoro
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap JS CDN -->
    <script 
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>
